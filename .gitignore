# Build output
/build*/
/out/
/cmake-build-*/
compile_commands.json
.cache/

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp

# Research corpus audio is local-only (rights + size). Keep docs/manifests.
/research/corpus/**/*.wav
/research/corpus/**/*.WAV
/research/corpus/**/*.wave
/research/corpus/**/*.aif
/research/corpus/**/*.aiff
/research/corpus/**/*.aifc
/research/corpus/**/*.AIF
/research/corpus/**/*.AIFF
/research/corpus/index.json

# Generated renders and reports (reproducible from the renderer)
/research/renders/*
!/research/renders/README.md
/research/reports/*
!/research/reports/README.md
/research/bakeoff/*/
!/research/bakeoff/listening-page/

# Python
__pycache__/
*.pyc
.venv/

# Visual QA renders (scripts/visual-review.sh); design/final-review is committed
/design/current/
/design/review/

# Rendered controls: masters, atlases and previews are regenerated (tools/blender-assets/README.md)
/tools/blender-assets/output/
__pycache__/

# Polyphonic Instrument Extraction Lab: its environment and generated audio, renders and runs.
/research/polyphonic-lab/.venv/
/research/polyphonic-lab/.venv-basic-pitch/
/research/polyphonic-lab/output/
/research/polyphonic-lab/**/__pycache__/
/research/polyphonic-lab/.pytest_cache/
/research/polyphonic-lab/*.egg-info/

# Factory packs: large, licensed audio; kept with the release, copied in before a build
/packaging/factory-packs/*.osppack
