/research/corpus/**/*.AIF
/research/corpus/**/*.AIFF
/research/corpus/index.json

# Generated renders and reports (reproducible from the renderer)
/research/renders/*
!/research/renders/README.md
/research/reports/*
!/research/reports/README.md

# Python
__pycache__/
*.pyc
.venv/
