*.swp

# Research corpus audio is local-only (rights + size). Keep docs/manifests.
/research/corpus/**/*.wav
/research/corpus/**/*.WAV
/research/corpus/**/*.wave
/research/corpus/**/*.aif
/research/corpus/**/*.aiff
