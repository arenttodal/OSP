{
  "schemaVersion": 1,
  "kind": "andor.learn.scenario",
  "id": "osp.scene.c2-grab-last",
  "product": "osp",
  "title": "Grab what you just played",
  "guides": [
    "osp.guide.make.grab-last"
  ],
  "learn": {
    "lessons": [],
    "steps": []
  },
  "editor": {
    "width": 1448,
    "scale": 2,
    "look": "ceramic"
  },
  "fps": 30,
  "maxSeconds": 15.0,
  "start": {
    "state": "one layer (Prophet-6 pad), Sidechain input connected, the phrase already playing into it",
    "input": true,
    "setup": [
      {
        "do": "addLayers",
        "sounds": [
          "file:Prophet-6 Pad.aif"
        ]
      },
      {
        "do": "input",
        "fixture": "input:phrase-d4",
        "loop": false
      },
      {
        "do": "settle",
        "seconds": 2.4
      }
    ]
  },
  "steps": [
    {
      "mark": "open-capture",
      "do": [
        {
          "do": "hold",
          "seconds": 0.5
        },
        {
          "do": "click",
          "target": "card:A.rec",
          "highlight": true
        },
        {
          "do": "highlight",
          "target": ""
        },
        {
          "do": "hold",
          "seconds": 2.6
        }
      ],
      "expect": [
        {
          "capturePage": true
        }
      ]
    },
    {
      "mark": "grab-last",
      "do": [
        {
          "do": "click",
          "target": "capture:grab0",
          "highlight": true
        },
        {
          "do": "highlight",
          "target": ""
        },
        {
          "do": "waitFor",
          "until": {
            "mapped": "A"
          },
          "timeout": 60
        },
        {
          "do": "hold",
          "seconds": 0.8
        }
      ],
      "expect": [
        {
          "layers": 1
        },
        {
          "state": "osp.source.mapped"
        },
        {
          "capturePage": false
        }
      ]
    },
    {
      "mark": "play-mapped",
      "do": [
        {
          "do": "highlight",
          "target": "learn:osp.keyboard"
        },
        {
          "do": "key",
          "note": 62,
          "seconds": 0.45,
          "after": 0.1
        },
        {
          "do": "key",
          "note": 65,
          "seconds": 0.45,
          "after": 0.1
        },
        {
          "do": "key",
          "note": 69,
          "seconds": 0.45,
          "after": 0.1
        },
        {
          "do": "key",
          "note": 72,
          "seconds": 0.7,
          "after": 0.1
        },
        {
          "do": "highlight",
          "target": ""
        },
        {
          "do": "hold",
          "seconds": 1.0
        }
      ],
      "expect": [
        {
          "notesPlayed": 4
        }
      ]
    }
  ],
  "frame": {
    "focus": [
      "card:A.card",
      "learn:osp.keyboard"
    ],
    "context": 0.04,
    "aspect": "16:10"
  },
  "outputs": [
    "webm",
    "mp4",
    "poster"
  ],
  "dependsOn": {
    "targets": [
      "osp.source.mapped",
      "osp.keyboard"
    ],
    "sources": [
      "shared/andor-ui/Source/EngineCard.cpp",
      "apps/plugin/Source/PluginEditor.cpp",
      "apps/plugin/Source/PluginProcessor.cpp",
      "shared/andor-ui/Source/EqEditor.cpp",
      "src/audio/capture/CaptureBuffer.cpp"
    ]
  },
  "disclosures": [
    "The input audio is a deterministic fixture (five sung vowels, D4 F4 A4 C5 A4) fed into OSP's Sidechain input bus by the capture runner, block by block, as a host would send it. The meter, level picture, trim, analysis and note mapping are OSP's own. Routing a DAW track to that input has not yet been verified in Logic, Ableton or Reaper.",
    "The input history before the first frame (2.4 s of the phrase) was fed during set-up, unfilmed."
  ]
}
