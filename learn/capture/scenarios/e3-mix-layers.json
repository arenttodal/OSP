{
  "schemaVersion": 1,
  "kind": "andor.learn.scenario",
  "id": "osp.scene.e3-mix-layers",
  "product": "osp",
  "title": "Balance, mute and solo layers",
  "guides": [
    "osp.guide.play.mix"
  ],
  "learn": {
    "lessons": [
      "osp.layers"
    ],
    "steps": []
  },
  "editor": {
    "width": 1448,
    "scale": 2,
    "look": "ceramic"
  },
  "fps": 30,
  "maxSeconds": 15.0,
  "start": {
    "state": "two layers (Prophet-6 pad, saw), a note held",
    "input": false,
    "setup": [
      {
        "do": "addLayers",
        "sounds": [
          "file:Prophet-6 Pad.aif",
          "gen:Saw C4.wav"
        ]
      },
      {
        "do": "holdNotes",
        "keys": [
          60
        ],
        "velocity": 90
      },
      {
        "do": "settle",
        "seconds": 0.6
      }
    ]
  },
  "steps": [
    {
      "mark": "level-b",
      "do": [
        {
          "do": "hold",
          "seconds": 0.6
        },
        {
          "do": "highlight",
          "target": "learn:osp.source.B.level"
        },
        {
          "do": "drag",
          "target": "learn:osp.source.B.level",
          "dy": 70,
          "seconds": 0.9
        },
        {
          "do": "highlight",
          "target": ""
        },
        {
          "do": "hold",
          "seconds": 0.6
        }
      ],
      "expect": [
        {
          "param": "layerB.level",
          "max": -3
        }
      ]
    },
    {
      "mark": "solo-b",
      "do": [
        {
          "do": "click",
          "target": "learn:osp.source.B.solo",
          "highlight": true
        },
        {
          "do": "highlight",
          "target": ""
        },
        {
          "do": "hold",
          "seconds": 1.2
        }
      ],
      "expect": [
        {
          "param": "layerB.solo",
          "equals": 1
        }
      ]
    },
    {
      "mark": "unsolo-b",
      "do": [
        {
          "do": "click",
          "target": "learn:osp.source.B.solo",
          "highlight": true
        },
        {
          "do": "highlight",
          "target": ""
        },
        {
          "do": "hold",
          "seconds": 0.6
        }
      ],
      "expect": [
        {
          "param": "layerB.solo",
          "equals": 0
        }
      ]
    },
    {
      "mark": "mute-a",
      "do": [
        {
          "do": "click",
          "target": "learn:osp.source.A.mute",
          "highlight": true
        },
        {
          "do": "highlight",
          "target": ""
        },
        {
          "do": "hold",
          "seconds": 1.2
        }
      ],
      "expect": [
        {
          "param": "layerA.mute",
          "equals": 1
        }
      ]
    }
  ],
  "frame": {
    "focus": [
      "card:A.card",
      "card:B.card"
    ],
    "context": 0.03,
    "aspect": "auto"
  },
  "outputs": [
    "webm",
    "mp4",
    "poster"
  ],
  "dependsOn": {
    "targets": [
      "osp.source.B.level",
      "osp.source.B.solo",
      "osp.source.A.mute"
    ],
    "sources": [
      "shared/andor-ui/Source/EngineCard.cpp"
    ]
  },
  "disclosures": [
    "Held notes are sent as MIDI by the runner, as a keyboard would; the on-screen keys light as they do for a MIDI keyboard."
  ]
}
