---
import GuidePage from '../../../../components/GuidePage.astro';
import { allGuides, slugOf } from '../../../../lib/guides';
export async function getStaticPaths() {
  const gs = await allGuides();
  return gs.map((g, i) => ({ params: { group: g.data.group, guide: slugOf(g) }, props: { guide: g, prev: gs[i - 1], next: gs[i + 1] } }));
}
const { guide, prev, next } = Astro.props;
---
<GuidePage guide={guide} prev={prev} next={next} />
