---
import Base from '../../../layouts/Base.astro';
import { groups } from '../../../data/groups';
import { allGuides, urlOf, clock } from '../../../lib/guides';
import { scene } from '../../../lib/scenes';
export async function getStaticPaths() { return groups.map((g) => ({ params: { group: g.slug }, props: { group: g } })); }
const { group } = Astro.props;
const guides = (await allGuides()).filter((g) => g.data.group === group.slug);
const base = import.meta.env.BASE_URL;
---
<Base title={`${group.title} · Learn ANDOR`}>
  <div class="wrap">
    <div class="crumbs"><a href={`${base}osp/`}>Learn ANDOR</a> / OSP</div>
    <h1>{group.title}</h1>
    <p class="lede">{group.blurb}</p>
    <ul class="card-grid">
      {guides.map((g) => {
        const s = scene(g.data.scene);
        return (
          <li>
            <a class="card" href={urlOf(g)}>
              <span class="card-media">
                <img src={s.poster} alt="" loading="lazy" width={s.width} height={s.height} />
                <span class="card-time">{clock(s.duration)}</span>
              </span>
              <span class="card-title">{g.data.title}</span>
              <span class="card-sub">{g.data.purpose}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</Base>
