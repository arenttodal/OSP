---
// The gallery: one featured clip, then a row per topic. Every card opens its guide.
import Base from '../../layouts/Base.astro';
import { groups } from '../../data/groups';
import { allGuides, urlOf, clock } from '../../lib/guides';
import { scene } from '../../lib/scenes';
const guides = await allGuides();
const base = import.meta.env.BASE_URL;
// Editorial choice: the feature shown at the top of the page.
const featured = guides.find((g) => g.data.id === 'osp.guide.play.pedal-loop')!;
const fs = scene(featured.data.scene);
---
<Base title="Learn ANDOR · OSP guides" current="home">
  <h1 class="sr-only">Learn ANDOR: guides for ANDOR OSP</h1>
  <section class="feature wrap" aria-labelledby="feature-title">
    <div class="feature-text">
      <span class="eyebrow">Featured · Play and layer</span>
      <h2 id="feature-title">Loop any note with the sustain pedal</h2>
      <p>Turn Loop off, set Pedal loop to Ping-Pong, and the pedal holds the part of the note you are playing, forward and back.</p>
      <div class="feature-cta">
        <a class="btn-primary" href={urlOf(featured)}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" /></svg>
          Watch the guide
        </a>
        <span class="meta">{clock(fs.duration)} · {featured.data.steps.length} steps</span>
      </div>
    </div>
    <div class="feature-clip">
      <video muted playsinline loop preload="metadata" poster={fs.poster} width={fs.width} height={fs.height}
             aria-label={`${fs.hasAudio ? 'Demonstration' : 'Silent demonstration'}: ${featured.data.title}`} data-feature>
        <source src={fs.webm} type="video/webm" />
        <source src={fs.mp4} type="video/mp4" />
      </video>
      {fs.hasAudio && (
        <button type="button" class="feature-sound" data-feature-sound aria-pressed="false" aria-label="Sound">
          <svg class="i-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z" /><path d="m17 9 4 6m0-6-4 6" /></svg>
          <svg class="i-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z" /><path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" /></svg>
        </button>
      )}
    </div>
  </section>

  <div class="rows">
    {groups.map((gr) => {
      const list = guides.filter((g) => g.data.group === gr.slug);
      return (
        <section class="row" aria-labelledby={`row-${gr.slug}`}>
          <div class="row-head wrap">
            <h2 id={`row-${gr.slug}`}><a href={`${base}osp/${gr.slug}/`}>{gr.title}</a></h2>
            <a class="row-all" href={`${base}osp/${gr.slug}/`}>All {list.length}</a>
          </div>
          <ul class="row-track">
            {list.map((g) => {
              const s = scene(g.data.scene);
              return (
                <li>
                  <a class="card" href={urlOf(g)}>
                    <span class="card-media">
                      <img src={s.poster} alt="" loading="lazy" width={s.width} height={s.height} />
                      <span class="card-time">{clock(s.duration)}</span>
                    </span>
                    <span class="card-title">{g.data.title}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      );
    })}
  </div>
  <script>
    const v = document.querySelector<HTMLVideoElement>('[data-feature]');
    if (v && !matchMedia('(prefers-reduced-motion: reduce)').matches) { v.play().catch(() => {}); }
    const b = document.querySelector<HTMLButtonElement>('[data-feature-sound]');
    if (v && b) b.addEventListener('click', () => {
      v.muted = !v.muted;
      b.setAttribute('aria-pressed', String(!v.muted));
      try { localStorage.setItem('learn-andor:sound', v.muted ? '0' : '1'); } catch { /* storage unavailable */ }
      if (!v.muted && v.paused) v.play().catch(() => {});
    });
  </script>
</Base>
