+
 void drawKeys (juce::Graphics& g, juce::Component& surface)
 {
     if (active() == nullptr)
         return;
     for (auto* child : surface.getChildren())
         if (const auto* face = dynamic_cast<const KeyFace*> (child); face != nullptr && child->isVisible() && face->keyOnSurface())
-            key (g, face->keyArea (child->getBounds().toFloat()), keyRadius (face->keyRole()), face->keyRole(), face->keyState());
+        {
+            // LOCAL K2 disabled pilot: a disabled key keeps its body (same size and construction) at
+            // rest, with no hover, press or active light, and its own ink (icon, label, lamp) at
+            // reduced contrast. The ink is the key component's own drawing: its alpha dims only that.
+            const bool enabled = child->isEnabled();
+            const float inkAlpha = enabled ? 1.0f : disabledInkAlpha;
+            if (std::abs (child->getAlpha() - inkAlpha) > 0.001f)
+                child->setAlpha (inkAlpha);
+            const auto state = ! enabled ? KeyState::normal
+                             : pilotForcedKeyState >= 0 ? static_cast<KeyState> (pilotForcedKeyState) : face->keyState();
+            key (g, face->keyArea (child->getBounds().toFloat()), keyRadius (face->keyRole()), face->keyRole(), state);
+        }
 }
 
 bool drawnBySurface() noexcept { return active() != nullptr; }
