cmake_minimum_required(VERSION 3.25)
# Fails when a file of andor_arp_core includes anything but another core file or a standard
# header (<...> without a '/' or '.', i.e. no <juce_core/juce_core.h>, no "ext.h").
# cmake -DROOT=<osp>/src -DFILES="a;b;..." -P CheckIncludes.cmake
set(_bad "")
foreach(_file IN LISTS FILES)
    file(STRINGS "${ROOT}/${_file}" _lines REGEX "^[ \t]*#[ \t]*include")
    foreach(_line IN LISTS _lines)
        if(_line MATCHES "\"([^\"]+)\"")
            if(NOT CMAKE_MATCH_1 IN_LIST FILES)
                list(APPEND _bad "${_file}: ${_line}")
            endif()
        elseif(_line MATCHES "<([^>]+)>")
            if(CMAKE_MATCH_1 MATCHES "[/.]")
                list(APPEND _bad "${_file}: ${_line}")
            endif()
        endif()
    endforeach()
endforeach()
if(_bad)
    list(JOIN _bad "\n  " _msg)
    message(FATAL_ERROR "andor_arp_core includes outside the core:\n  ${_msg}")
endif()
list(LENGTH FILES _n)
message(STATUS "andor_arp_core: ${_n} files, includes only the core and the standard library")
